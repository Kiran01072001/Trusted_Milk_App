{
  "expo": {
    "name": "Trusted Milk",
    "slug": "trusted-milk",
    "scheme": "trusted-milk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/appicon.jpeg",
    "splash": {
      "backgroundColor": "#025F86"
    },
    "ios": { "supportsTablet": false },
    "android": {
      "package": "com.trustedmilk.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/appicon.jpeg",
        "backgroundColor": "#025F86"
      },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"],
      "navigationBarColor": "#FFFFFF",
      "navigationBarStyle": "dark-content"
    },
    "plugins": ["expo-location"]
  }
}
